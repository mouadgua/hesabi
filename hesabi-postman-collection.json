{
  "info": {
    "name": "Hesabi — Security Audit Collection",
    "description": "Tests complets : auth, IDOR, injections, uploads, rate limiting, edge cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authCookie",
      "value": "",
      "description": "Cookie de session valide (copier depuis DevTools apres login)"
    },
    {
      "key": "otherUserCookie",
      "value": "",
      "description": "Cookie d'un autre utilisateur (autre cabinet)"
    },
    {
      "key": "documentId",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "otherDocId",
      "value": "00000000-0000-0000-0000-000000000002"
    },
    {
      "key": "templateId",
      "value": "00000000-0000-0000-0000-000000000003"
    },
    {
      "key": "demoAdminSecret",
      "value": "changeme"
    },
    {
      "key": "workerSecret",
      "value": "changeme"
    }
  ],
  "item": [
    {
      "name": "Auth Guards",
      "item": [
        {
          "name": "Upload sans token -> 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "text",
                  "value": "fake"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sans auth', () => pm.response.to.have.status(401));",
                  "pm.test('Pas de donnees sensibles', () => { const t = pm.response.text(); pm.expect(t).to.not.include('cabinet_id'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Export sans token -> 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/export",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "documentIds",
                  "value": "{{documentId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sans auth', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Export Mass sans token -> 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/export-mass",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "documentIds",
                  "value": "{{documentId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sans auth', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Notifications sans token -> 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sans auth', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Corrections sans token -> 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/corrections/save",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"field_name\": \"test\", \"corrected_value\": \"val\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sans auth', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload fichier valide -> 200",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/test.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 + documentId present', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('documentId'); });",
                  "pm.collectionVariables.set('documentId', pm.response.json().documentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload .php renomme .jpg (magic bytes invalides) -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/malicious.php.jpg",
                  "description": "echo '<?php system($_GET[cmd]); ?>' > malicious.php.jpg"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 magic bytes invalides', () => pm.response.to.have.status(400));",
                  "pm.test('Message clair', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload fichier 0 octet -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/empty.pdf",
                  "description": "touch empty.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejet propre 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload fichier > 20 Mo -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/big-21mb.pdf",
                  "description": "dd if=/dev/urandom of=big.pdf bs=1M count=21"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 trop volumineux', () => pm.response.to.have.status(400));",
                  "pm.test('Message mentionne la taille', () => pm.expect(pm.response.json().error).to.include('Mo'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload extension non supportee (.exe) -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/malware.exe"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 format non supporte', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload dossier_id autre cabinet -> 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/test.pdf"
                },
                {
                  "key": "dossier_id",
                  "value": "00000000-dead-beef-0000-000000000000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 dossier invalide', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]

                  "pm.test('X-Content-Type-Options nosniff', () => { pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff'); });",
                  "pm.test('Referrer-Policy present', () => { pm.expect(pm.response.headers.get('Referrer-Policy')).to.be.a('string'); });",

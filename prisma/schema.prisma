generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- 1. L'ÉQUIPE ---
model Utilisateur {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cabinet_id      String?  @db.Uuid
  email           String   @unique
  nom             String
  role            RoleUser @default(COLLABORATEUR)
  actif           Boolean  @default(true)
  onboarding_done Boolean  @default(false)
  createdAt       DateTime @default(now())
  last_active_at  DateTime?

  cabinet         Cabinet? @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
}

model Cabinet {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                 String
  logo_url            String?
  plan_abonnement     String   @default("PRO")
  createdAt           DateTime @default(now())

  credits             Int      @default(15)
  credits_limit       Int      @default(15)  // admin-adjustable quota

  stripe_customer_id     String?  @unique
  stripe_subscription_id String?  @unique
  plan_status            String   @default("TRIAL")

  suspended           Boolean  @default(false)
  suspend_reason      String?

  extraction_method   String   @default("gemini")  // "gemini" | "hybrid_azure"

  ice                 String?
  identifiant_fiscal  String?
  registre_commerce   String?
  patente             String?
  adresse             String?
  ville               String?
  code_postal         String?
  telephone           String?
  site_web            String?

  utilisateurs        Utilisateur[]
  clients             Client[]
  templates           TemplateExtraction[]
  comptes_comptables  CompteComptable[]
  account_preferences CabinetAccountPreference[]
  export_templates    ExportTemplate[]
}


// --- 2. LES CLIENTS ---
model Client {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cabinet_id         String   @db.Uuid
  nom_entreprise     String

  ice                String?  @db.VarChar(15)
  identifiant_fiscal String?
  registre_commerce  String?
  rib                String?  @db.VarChar(24)
  adresse            String?
  ville              String?

  statut             StatutClient @default(ACTIF)
  createdAt          DateTime @default(now())

  cabinet            Cabinet    @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
  documents          Document[]
  dossiers           Dossier[]

  @@index([cabinet_id])
}

// --- 3. MODÈLES D'EXTRACTION (PRESETS) ---
model TemplateExtraction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cabinet_id      String   @db.Uuid
  nom_modele      String
  structure_json  Json
  createdAt       DateTime @default(now())

  cabinet         Cabinet    @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
  documents       Document[]
}

model Dossier {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom        String
  client_id  String   @db.Uuid
  parent_id  String?  @db.Uuid
  createdAt  DateTime @default(now())

  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  documents  Document[]

  @@index([client_id])
}

// --- 4. LE FILE MANAGER (DOCUMENTS) ---
model Document {
  id                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id                   String         @db.Uuid
  template_id                 String?        @db.Uuid
  nom_fichier                 String?
  chemin_storage              String         @db.Text
  statut                      DocumentStatut @default(A_EXTRAIRE)
  donnees_extraites           Json?
  document_type               String?
  document_type_confidence    Float?
  fournisseur_detecte         String?
  error_message               String?        @db.Text
  // AI tracking fields
  ai_provider                 String?        // gemini-pdf | claude-haiku | gpt-4o | gemini-flash | qwen
  processing_ms               Int?           // wall-clock extraction time
  tokens_in                   Int?
  tokens_out                  Int?
  extraction_method_used      String?        // "gemini-pdf" | "hybrid_azure" | provider name
  extraction_cost_est         Float?         // estimated USD cost of this extraction
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  client             Client              @relation(fields: [client_id], references: [id], onDelete: Cascade)
  template           TemplateExtraction? @relation(fields: [template_id], references: [id])
  dossier_id         String?  @db.Uuid
  dossier            Dossier? @relation(fields: [dossier_id], references: [id])
  compte_comptable   DocumentCompteComptable?

  @@index([client_id, statut])
  @@index([statut, updatedAt])
  @@index([template_id])
  @@index([dossier_id])
}

// --- 5. LEARNING LOOP ---
model FieldCorrection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  document_type   String
  field_name      String
  original_value  String?  @db.Text
  corrected_value String   @db.Text
  supplier_name   String?
  createdAt       DateTime @default(now())

  @@index([user_id, document_type])
}

model UserFieldPreference {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  document_type    String
  preferred_fields Json?
  excluded_fields  Json?
  field_aliases    Json?
  updatedAt        DateTime @updatedAt

  @@unique([user_id, document_type])
}

// --- 6. MISSING FIELD FEEDBACK ---
model MissingFieldRequest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  document_type String
  field_name    String
  document_id   String?  @db.Uuid
  createdAt     DateTime @default(now())
}

// --- 7. BETA ACCESS KEYS (extended) ---
model BetaKey {
  id          String    @id @default(cuid())
  key         String    @unique
  email       String?   // assigned to specific email (optional — open if null)
  note        String?   // admin internal note
  used        Boolean   @default(false)
  used_by     String?   // email of user who redeemed
  used_at     DateTime?
  expires_at  DateTime?
  max_uses    Int?      // null = unlimited, 1 = single-use
  use_count   Int       @default(0)
  credits     Int       @default(15)  // extractions granted on redemption
  is_active   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// --- 8. ADMIN AUDIT LOG ---
model AdminLog {
  id        String   @id @default(cuid())
  action    String   // e.g. "SUSPEND_USER", "GENERATE_KEY", "ADJUST_QUOTA"
  entity    String?  // e.g. "cabinet" | "beta_key" | "system"
  entity_id String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// --- 9. DEMO ATTEMPTS (persistent — rateLimiter is in-memory only) ---
model DemoAttempt {
  id         String   @id @default(cuid())
  email      String
  session_id String?
  status     String   // SUCCESS | BLOCKED_SESSION | BLOCKED_EMAIL
  doc_type   String?
  ip_hash    String?
  createdAt  DateTime @default(now())
}

// --- 10. SITE VISITS ---
model SiteVisit {
  id        String   @id @default(cuid())
  site      String   // main | demo
  path      String?
  ip_hash   String?
  device    String?  // mobile | desktop | tablet
  createdAt DateTime @default(now())
}

// --- 11. USER RATINGS & INBOX ---
model UserRating {
  id        String   @id @default(cuid())
  user_id   String?
  email     String?
  rating    Int      // 1–5
  comment   String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- 12. PLAN COMPTABLE (CGNC) ---
model CompteComptable {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cabinet_id   String?  @db.Uuid  // null = compte CGNC standard partagé
  code         String
  libelle      String
  classe       Int                // 1-8
  parent_id    String?  @db.Uuid
  actif        Boolean  @default(true)
  is_standard  Boolean  @default(false)

  cabinet      Cabinet?              @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
  parent       CompteComptable?      @relation("SousComptes", fields: [parent_id], references: [id])
  sous_comptes CompteComptable[]     @relation("SousComptes")
  documents    DocumentCompteComptable[]
  preferences  CabinetAccountPreference[]

  @@index([cabinet_id])
  @@index([classe])
  @@index([code])
}

model DocumentCompteComptable {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id      String        @unique @db.Uuid
  compte_id        String        @db.Uuid
  source           CompteSource  @default(VALIDATION_MANUELLE)
  confidence_score Float?
  assignedAt       DateTime      @default(now())

  document         Document        @relation(fields: [document_id], references: [id], onDelete: Cascade)
  compte           CompteComptable @relation(fields: [compte_id], references: [id])

  @@index([compte_id])
}

model CabinetAccountPreference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cabinet_id     String   @db.Uuid
  document_type  String
  fournisseur_key String
  compte_id      String   @db.Uuid
  use_count      Int      @default(1)
  updatedAt      DateTime @updatedAt

  cabinet        Cabinet         @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
  compte         CompteComptable @relation(fields: [compte_id], references: [id])

  @@unique([cabinet_id, document_type, fournisseur_key])
  @@index([cabinet_id])
}

// --- 13. EXPORT TEMPLATES (saved column configs) ---
model ExportTemplate {
  id         String   @id @default(cuid())
  cabinet_id String   @db.Uuid
  name       String
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cabinet    Cabinet  @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)

  @@index([cabinet_id])
}

// --- ÉNUMÉRATIONS ---
enum DocumentStatut {
  A_EXTRAIRE
  EN_COURS_IA
  A_VERIFIER
  VALIDE
  REJETE
}

enum StatutClient {
  ACTIF
  ARCHIVE
}

enum RoleUser {
  EXPERT_COMPTABLE
  COLLABORATEUR
}

enum CompteSource {
  SUGGESTION_IA
  VALIDATION_MANUELLE
}
